# Optional overrides for artifact file paths
MODEL_DIR=models
LEVEL1_MODEL_FILE=metaguard_level1_reptile.pt.zip
LEVEL2_MODEL_FILE=metaguard_level2_openset.pt.zip
SCALER_FILE=metaguard_scaler.pkl
ENCODER_FILE=metaguard_level2_encoder.pkl
PROTOTYPES_FILE=metaguard_prototypes.pt.zip

# Optional: set explicit distance threshold for open-set decision
# OPENSET_DISTANCE_THRESHOLD=0.85

# Optional: Add your GEMINI API key here to enable AI explanations in the dashboard
GEMINI_API_KEY=your_gemini_api_key_here

# If OPENSET_DISTANCE_THRESHOLD is unset, threshold is auto-computed
OPENSET_THRESHOLD_MULTIPLIER=1.10
